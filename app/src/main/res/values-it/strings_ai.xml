<resources>
    <!-- Settings dialog (also the menu item) -->
    <string name="ai_title">Meccanico IA</string>
    <string name="ai_explanation">Quando l\'adattatore OBD si connette, Dashwheel cerca da solo i codici guasto. Ogni nuovo codice viene spiegato da Google Gemini e letto ad alta voce; i dettagli compaiono nel riquadro Codici guasto. Vengono inviati solo i codici, i dati del motore e il modello dell\'auto.</string>
    <string name="ai_activation_code">Codice di attivazione</string>
    <string name="ai_activation_hint">Sblocca la chiave integrata</string>
    <string name="ai_activate">Attiva</string>
    <string name="ai_own_key">Oppure la tua chiave API Gemini</string>
    <string name="ai_key">Chiave API Gemini</string>
    <string name="ai_key_hint">Gratis su aistudio.google.com → Get API key</string>
    <string name="ai_engine">Motore</string>
    <string name="ai_language">Lingua</string>
    <string name="ai_language_auto">Come l\'app</string>
    <string name="ai_speak">Avvisi vocali</string>
