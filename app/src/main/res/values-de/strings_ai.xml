<resources>
    <!-- Settings dialog (also the menu item) -->
    <string name="ai_title">KI-Mechaniker</string>
    <string name="ai_explanation">Sobald der OBD-Adapter verbunden ist, sucht Dashwheel selbstständig nach Fehlercodes. Ein neuer Code wird von Google Gemini erklärt und vorgelesen; die Details erscheinen auf der Kachel „Fehlercodes“. Gesendet werden nur die Codes, die Motorwerte und das Fahrzeugmodell.</string>
    <string name="ai_activation_code">Aktivierungscode</string>
    <string name="ai_activation_hint">Schaltet den integrierten Schlüssel frei</string>
    <string name="ai_activate">Aktivieren</string>
    <string name="ai_own_key">Oder eigener Gemini-API-Schlüssel</string>
    <string name="ai_key">Gemini-API-Schlüssel</string>
    <string name="ai_key_hint">Kostenlos auf aistudio.google.com → Get API key</string>
    <string name="ai_engine">Motor</string>
    <string name="ai_language">Sprache</string>
    <string name="ai_language_auto">Wie die App</string>
    <string name="ai_speak">Warnungen ansagen</string>
    <string name="ai_speak_detail">Neue Fehlercodes, Überhitzung, Batterie lädt nicht</string>
    <string name="ai_test">Testen</string>
    <string name="ai_done">Fertig</string>

    <!-- Settings dialog: test results -->
    <string name="ai_test_ok">Gemini funktioniert ✓ (%1$s).</string>
