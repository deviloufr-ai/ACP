    <string name="ai_say_ready">Der KI-Mechaniker ist bereit.</string>
    <plurals name="ai_say_new_codes">
        <item quantity="one">%1$d neuer Motor-Fehlercode: %2$s. Details auf dem Bildschirm.</item>
        <item quantity="other">%1$d neue Motor-Fehlercodes: %2$s. Details auf dem Bildschirm.</item>
    </plurals>
    <string name="ai_say_overheat">Achtung, der Motor überhitzt: %1$d Grad. Sobald es sicher ist, anhalten und den Motor abstellen.</string>
    <string name="ai_say_not_charging">Die Batterie wird nicht geladen: %1$s Volt bei laufendem Motor. Eine Werkstatt anfahren und unnötige Verbraucher ausschalten.</string>
    <string name="ai_say_weak_battery">Die Batterie ist schwach: %1$s Volt bei abgestelltem Motor. Bald prüfen lassen.</string>

